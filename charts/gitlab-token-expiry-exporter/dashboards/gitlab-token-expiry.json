{
  "uid": "gitlab-token-expiry",
  "title": "GitLab token expiry",
  "tags": [
    "gitlab",
    "tokens"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "15m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Active tokens by time to expiry",
      "gridPos": {
        "h": 14,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gitlab_token_days_remaining{active=\"true\", revoked=\"false\"} >= 0",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "container": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "id": true,
              "active": true,
              "revoked": true
            },
            "renameByName": {
              "Value": "days remaining",
              "name": "token",
              "type": "type",
              "expires_at": "expires",
              "scopes": "scopes",
              "access_level": "access level",
              "web_url": "url",
              "project": "project",
              "group": "group"
            },
            "indexByName": {
              "name": 0,
              "type": 1,
              "project": 2,
              "group": 3,
              "Value": 4,
              "expires_at": 5,
              "scopes": 6,
              "access_level": 7,
              "web_url": 8
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "days remaining",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "days remaining"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 14
                    },
                    {
                      "color": "yellow",
                      "value": 45
                    },
                    {
                      "color": "green",
                      "value": 90
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "open",
                    "url": "${__value.text}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "table",
      "title": "Already expired (no active replacement)",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gitlab_token_days_remaining{revoked=\"false\"} < 0 unless on(name, type, project, group) (gitlab_token_days_remaining{active=\"true\"} >= 0)",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "container": true,
              "endpoint": true,
              "namespace": true,
              "pod": true,
              "service": true,
              "id": true,
              "revoked": true
            },
            "renameByName": {
              "Value": "days remaining",
              "name": "token",
              "type": "type",
              "expires_at": "expired on",
              "scopes": "scopes",
              "active": "active",
              "access_level": "access level",
              "web_url": "url",
              "project": "project",
              "group": "group"
            },
            "indexByName": {
              "name": 0,
              "type": 1,
              "project": 2,
              "group": 3,
              "Value": 4,
              "expires_at": 5,
              "active": 6,
              "scopes": 7,
              "access_level": 8,
              "web_url": 9
            }
          }
        }
      ],
      "options": {
        "sortBy": [
          {
            "displayName": "days remaining",
            "desc": false
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "days remaining"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "url"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "open",
                    "url": "${__value.text}",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    }
  ]
}
